{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(docker compose:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./pems/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/sso/**)",
      "Read(~/.aws/cli/cache/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ensure-build.sh",
            "timeout": 600,
            "statusMessage": "Keeping ./bin/cloudssh up to date..."
          }
        ]
      }
    ]
  }
}
